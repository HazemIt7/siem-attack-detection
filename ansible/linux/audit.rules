# Wazuh SIEM - Auditd rules for Threat Detection

-D
-b 8192
-f 1

# --- 1. Execution of Suspicious/Network Binaries (C2 / Exfiltration) ---

-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/curl -F auid>=1000 -F auid!=4294967295 -k susp_curl
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/scp  -F auid>=1000 -F auid!=4294967295 -k susp_scp
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/ssh  -F auid>=1000 -F auid!=4294967295 -k susp_ssh
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/arp  -F auid>=1000 -F auid!=4294967295 -k susp_arp
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/host -F auid>=1000 -F auid!=4294967295 -k susp_host

# --- 2. System and User Discovery ---
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/whoami   -F auid>=1000 -F auid!=4294967295 -k susp_whoami
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/groups   -F auid>=1000 -F auid!=4294967295 -k susp_groups
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/ps       -F auid>=1000 -F auid!=4294967295 -k susp_ps
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/ifconfig -F auid>=1000 -F auid!=4294967295 -k susp_ifconfig
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/hostname -F auid>=1000 -F auid!=4294967295 -k susp_hostname



# --- 3. File Search and Collection (Staging) ---
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/find -F auid>=1000 -F auid!=4294967295 -k susp_find
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/tar -F auid>=1000 -F auid!=4294967295 -k susp_tar


# --- 4. Modification of File Attributes and Execution ---
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/chmod    -F auid>=1000 -F auid!=4294967295 -k susp_chmod
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/base64   -F auid>=1000 -F auid!=4294967295 -k susp_base64
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/truncate -F auid>=1000 -F auid!=4294967295 -k susp_truncate
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/touch    -F auid>=1000 -F auid!=4294967295 -k susp_touch
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/stat     -F auid>=1000 -F auid!=4294967295 -k susp_stat



# --- 5. Defense Evasion and Firewall Tampering ---
-w /etc/ufw/ -p wa -k susp_ufw_config
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/sbin/ufw -F auid>=1000 -F auid!=4294967295 -k susp_ufw
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/free -F auid>=1000 -F auid!=4294967295 -k susp_free


# --- 6. Log Tampering and Clearing History ---
-w /var/log/auth.log -p wa -k susp_log_tampering
-w /var/log/syslog -p wa -k susp_log_tampering

# Watch for bash history modifications (wildcards like /home/*/.bash_history are NOT supported by auditd)
# We will watch the /root directory for file changes instead to detect root's bash history being tampered
-w /root/.bash_history -p wa -k susp_history

# --- 7. Execution of Python / Interpreters ---
-w /usr/bin/python3 -p x -k susp_python


# --- 8. Suspicious Directories (Hidden / Temp) ---
-w /tmp/ -p wa -k susp_tmp_activity
-w /var/tmp/ -p wa -k susp_tmp_activity


# --- 9. file watch ---
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity 
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d/ -p wa -k privilege
-w /etc/ssh/sshd_config -p wa -k ssh_config
-w /etc/ssh/sshd_config.d -p wa -k ssh_config

# --- 10. binary execution ---
-a always,exit -S execve,execveat -F path=/usr/bin/sudo -F perm=x -F auid>=1000 -F auid!=4294967295 -k sudo_a

# --- 11. auth ---
-w /etc/pam.d/ -p wa -k auth_config

-e 2

