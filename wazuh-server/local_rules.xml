<rule id="100024" level="0">
    <if_sid>100002</if_sid>
    <field name="audit.exe">^/usr/sbin/sshd$</field>
    <description>Exception : Lecture légitime de /etc/shadow par le service SSH (ignorée)</description>
  </rule>

<rule id="100025" level="0">
    <if_sid>100007</if_sid>
    <field name="audit.exe">^/var/ossec$</field>
    <description>Exception : lecture du fichier shadow par ossec </description>
  </rule>





<rule id="100028" level="0">
    <if_sid>100002</if_sid>
    <field name="audit.exe">^/usr/lib/systemd/systemd-executor$</field>
    <description>Exception : Lecture légitime de /etc/shadow par systemd-executor (ignorée)</description>
  </rule>

<rule id="100029" level="0">
    <if_sid>100019</if_sid>
    <field name="audit.exe">^/usr/bin/systemctl$|^/bin/systemctl$</field>
    <field name="audit.execve.a1">^--user$</field>
    <description>Exception : Commande systemctl légitime pour la session utilisateur (ignorée)</description>
  </rule>

<rule id="100030" level="0">
    <if_sid>100007</if_sid>
    <field name="audit.exe">^/usr/bin/uname$|^/bin/uname$</field>
    <field name="audit.execve.a1">^-o$|^-r$|^-m$</field>
    <description>Exception : Exécution légitime de uname par les scripts de connexion</description>
  </rule>

  <rule id="100031" level="0">
    <if_sid>100007</if_sid>
    <field name="audit.exe">^/usr/bin/cat$|^/bin/cat$</field>
    <field name="audit.execve.a1">^/var/cache/motd-news$|^/run/motd.d/|^/var/lib/update-notifier/</field>
    <description>Exception : Lecture des fichiers de bienvenue/mises à jour à la connexion</description>
  </rule>

  <rule id="100032" level="0">
    <if_sid>100007</if_sid>
    <field name="audit.exe">^/usr/bin/id$|^/bin/id$</field>
    <field name="audit.execve.a1">^-u$</field>
