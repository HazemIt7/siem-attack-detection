    <description>Exception : Rotation et gestion des permissions du journal dmesg (ignorée)</description>
  </rule>


  <rule id="100036" level="0">
    <if_group>custom_rules</if_group>
    <field name="audit.exe">^/var/ossec/bin/wazuh-agentd$|^/var/ossec/bin/wazuh-syscheckd$|^/var/ossec/bin/wazuh-logcollector$|^/var/ossec/bin/wazuh-modulesd$|^/var/ossec/bin/wazuh-execd$</field>
    <description>Exception : Processus internes de l'agent Wazuh autorisés (ignorée)</description>
  </rule>


  <rule id="100037" level="0">
    <if_sid>100003</if_sid>
    <field name="audit.cwd">^/var/ossec$</field>
    <field name="audit.auid">^4294967295$</field>
    <field name="audit.exe">^/usr/sbin/useradd$</field>
    <field name="audit.execve.a1">^-D$</field>
    <description>Exception : Vérification des politiques de comptes par le module SCA Wazuh (ignorée)</description>
  </rule>

  <rule id="100038" level="0">
