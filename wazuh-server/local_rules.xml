<group name="auditd, custom_attacks,">

  <!-- 1. C2 & Exfiltration -->
  <rule id="100100" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">susp_curl|susp_scp|susp_ssh|susp_arp|susp_host</field>
    <description>Auditd: Suspicious network binary execution detected (Possible C2/Exfiltration)</description>
    <mitre>
      <id>T1048</id>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- 2. System and User Discovery -->
  <rule id="100101" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">susp_whoami|susp_groups|susp_ps|susp_ifconfig|susp_hostname</field>
    <description>Auditd: System and user discovery binary execution detected</description>
    <mitre>
      <id>T1033</id>
      <id>T1082</id>
    </mitre>
  </rule>

  <!-- 3. File Search and Collection (Staging) -->
  <rule id="100102" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.key">susp_find|susp_tar|susp_xclip</field>
    <description>Auditd: File search and collection binary execution detected</description>
    <mitre>
      <id>T1560</id>
      <id>T1119</id>
    </mitre>
  </rule>

  <!-- 4. Defense Evasion & Attribute Modification -->
  <rule id="100103" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">susp_chmod|susp_base64|susp_truncate|susp_touch|susp_stat</field>
    <description>Auditd: Execution of binaries commonly used for defense evasion or attribute modification</description>
    <mitre>
      <id>T1222.002</id>
      <id>T1140</id>
    </mitre>
  </rule>

  <!-- 5. Firewall Tampering -->
  <rule id="100104" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">susp_ufw|susp_ufw_config|susp_free</field>
    <description>Auditd: Tampering with UFW firewall configuration or memory clearing</description>
    <mitre>
      <id>T1562.004</id>
    </mitre>
  </rule>

  <!-- 6. Log Tampering -->
  <rule id="100105" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">susp_log_tampering|susp_mail_spool|susp_history</field>
    <description>Auditd: Modification or deletion of system logs or bash history (Defense Evasion)</description>
    <mitre>
      <id>T1070.002</id>
      <id>T1070.003</id>
    </mitre>
  </rule>

  <!-- 7. Interpreter Execution -->
  <rule id="100106" level="6">
    <if_sid>80700</if_sid>
    <field name="audit.key">susp_python</field>
    <description>Auditd: Execution of Python interpreters</description>
    <mitre>
      <id>T1059.006</id>
    </mitre>
  </rule>

  <!-- 8. Suspicious Directories Activity -->
  <rule id="100107" level="6">
    <if_sid>80700, 80780</if_sid>
    <field name="audit.key">susp_tmp_activity</field>
    <description>Auditd: Suspicious activity in temporary directories (/tmp or /var/tmp)</description>
    <mitre>
      <id>T1074</id>
    </mitre>
  </rule>


<!-- 9. Identity & Account Files Modification -->
  <rule id="100108" level="10">
    <if_sid>80700, 80780</if_sid>
    <field name="audit.key">^identity$</field>
    <description>Auditd: Critical user or group database modified ($(audit.file.name)) by user $(audit.auid)</description>
    <mitre>
      <id>T1078</id>
      <id>T1098</id>
    </mitre>
  </rule>


<!-- 10. Sudoers & Privilege Delegation Tampering -->
  <rule id="100109" level="12">
    <if_sid>80700, 80780</if_sid>
    <field name="audit.key">^privilege$</field>
    <description>Auditd: Sudoers file or directory modified ($(audit.file.name)) [Privilege Escalation]</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>


<!-- 11. SSH Daemon Configuration Modification -->
  <rule id="100110" level="9">
    <if_sid>80700, 80780</if_sid>
    <field name="audit.key">^ssh_config$</field>
    <description>Auditd: SSH daemon configuration changed ($(audit.file.name))</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
  </rule>

<!-- 12. Execution of sudo by a non-system user (audit.key: sudo_a) -->
  <rule id="100111" level="6">
    <if_sid>80700</if_sid>
    <field name="audit.key">^sudo_a$</field>
    <description>Auditd: Privileged command execution via sudo by user ID $(audit.auid) [cmd: $(audit.exe)]</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <!-- 13. PAM configuration modification / file watch (audit.key: auth.config) -->
  <rule id="100112" level="12">
    <if_sid>80700, 80780</if_sid>
    <field name="audit.key">^auth_config$</field>
    <description>Auditd: Critical PAM authentication configuration modified ($(audit.file.name)) [Defense Evasion/Persistence]</description>
    <mitre>
      <id>T1556</id>
      <id>T1078</id>
    </mitre>
  </rule>

</group>

<!-- ========================================================================= -->
<!-- OFFICIAL WAZUH VIRUSTOTAL INTEGRATION & ACTIVE RESPONSE RULES            -->
<!-- Documentation: https://documentation.wazuh.com/current/proof-of-concept-guide/detect-remove-malware-virustotal.html -->
<!-- ========================================================================= -->

<group name="syscheck,pci_dss_11.5,nist_800_53_SI.7,">
    <!-- Rules to trigger VirusTotal on modified/added files in monitored paths -->
    <rule id="100200" level="7">
        <if_sid>550</if_sid>
        <field name="file">/root|/tmp</field>
        <description>File modified in /root or /tmp directory.</description>
    </rule>
    <rule id="100201" level="7">
        <if_sid>554</if_sid>
        <field name="file">/root|/tmp</field>
        <description>File added to /root or /tmp directory.</description>
    </rule>
</group>

<group name="virustotal,">
  <!-- Active Response Feedback Rules (Rule 657 is active response output) -->
  <rule id="100092" level="12">
    <if_sid>657</if_sid>
    <match>Successfully removed threat</match>
    <description>$(parameters.program) removed threat located at $(parameters.alert.data.virustotal.source.file)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <rule id="100093" level="12">
    <if_sid>657</if_sid>
    <match>Error removing threat</match>
    <description>Error removing threat located at $(parameters.alert.data.virustotal.source.file)</description>
  </rule>
</group>
