#!/usr/bin/env python3
import sys
import json
import urllib.request

# 1. Vérification et lecture des arguments passés par Wazuh
if len(sys.argv) < 4:
    sys.stderr.write(f"Erreur: Arguments insuffisants ({len(sys.argv)} reçus, 4 attendus)\n")
    sys.exit(1)

alert_file = sys.argv[1]
# sys.argv[2] contient l'API key (ou vide/non renseigné)
hook_url = sys.argv[3]

# 2. Lecture du fichier JSON d'alerte
try:
    with open(alert_file, 'r', encoding='utf-8') as f:
        alert_json = json.load(f)
except Exception as e:
    sys.stderr.write(f"Erreur de lecture du fichier d'alerte: {e}\n")
    sys.exit(1)

# 3. Extraction sécurisée des métadonnées (gestion des clés 'null')
rule = alert_json.get('rule') or {}
rule_id = rule.get('id', 'N/A')
rule_level = rule.get('level', 0)
rule_desc = rule.get('description', 'Alerte Wazuh')

mitre = rule.get('mitre') or {}
mitre_ids = mitre.get('id', [])
if isinstance(mitre_ids, str):
    mitre_ids = [mitre_ids]

agent = alert_json.get('agent') or {}
agent_name = agent.get('name', 'Serveur Wazuh')
agent_ip = agent.get('ip', 'N/A')

data = alert_json.get('data') or {}
src_ip = data.get('srcip') or alert_json.get('srcip') or 'N/A'

# Couleur de l'embed Discord : Rouge (>=12), Orange (>=10), Bleu par défaut
color = 15158332 if rule_level >= 12 else (15105570 if rule_level >= 10 else 3447003)

# 4. Formatage du message pour Discord
mitre_text = ', '.join(mitre_ids) if mitre_ids else 'N/A'

payload = {
    "username": "Wazuh SOC Alert",
    "avatar_url": "https://wazuh.com/uploads/2022/07/wazuh_logo.png",
    "embeds": [{
        "title": f"🚨 Alerte Sécurité - Niveau {rule_level}",
        "description": f"**{rule_desc}**",
        "color": color,
        "fields": [
            {"name": "Agent", "value": f"`{agent_name}` ({agent_ip})", "inline": True},
            {"name": "Règle ID", "value": f"`{rule_id}`", "inline": True},
            {"name": "IP Source / Attaquant", "value": f"`{src_ip}`", "inline": True},
            {"name": "MITRE ATT&CK", "value": f"`{mitre_text}`", "inline": False}
        ],
        "footer": {"text": "Wazuh SIEM/EDR • Détection en temps réel"}
    }]
}

# 5. Envoi HTTP POST vers Discord
req = urllib.request.Request(
    hook_url,
    data=json.dumps(payload).encode('utf-8'),
    headers={
        'Content-Type': 'application/json',
        'User-Agent': 'Wazuh-Webhook'
    }
)

try:
    with urllib.request.urlopen(req, timeout=10) as response:
        if response.status not in (200, 204):
            sys.stderr.write(f"Réponse Discord inattendue: {response.status}\n")
except Exception as e:
    sys.stderr.write(f"Erreur d'envoi webhook: {e}\n")
    sys.exit(1)

sys.exit(0)
